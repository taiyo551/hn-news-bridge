      "id": "HN-50366117",
      "hn_id": 50366117,
      "title": "Ask HN: What's your current AI agentic setup?",
      "url": "https://news.ycombinator.com/item?id=50366117",
      "hn_url": "https://news.ycombinator.com/item?id=50366117",
      "category": "AI",
      "posted_at": "2026-11-04T14:37:22Z",
