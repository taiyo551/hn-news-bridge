    {
      "id": "HN-50512685",
      "hn_id": 50512685,
      "title": "Show HN: gavel: guided code review with your coding agent",
      "url": "https://photostructure.com/coding/gavel/",
      "hn_url": "https://news.ycombinator.com/item?id=50512685",
      "category": "Other",
      "posted_at": "2026-11-16T00:52:02Z",
      "fetched_at": "2026-11-17T20:59:39Z",
      "score": 4,
      "comment_count": 2,
      "score_gain_24h_observed": null,
      "comment_gain_24h_observed": null,
      "keywords": [
        "code review",
        "coding agent"
      ],
      "selection_hints": [
        "agent",
        "coding"
      ],
      "snippet": "Howdy! I've been working on an open-source tool that helps lighten the burden of reviewing what your coding agents write. You still see all the lines of code, but the agents write a \"tour guide\" that links you through the local PR, and as you have questions or comments, you chat with your agent in the context of the code, in a threaded conversation. I called it \"gavel\" (you make your agents build a case that you judge). Hope you find it as useful as I do! https://github.com/photostructure/gavel"
    },
